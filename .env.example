# URL da aplicação local, usada pelo servidor de desenvolvimento e links absolutos
APP_URL=http://localhost:3000

# Authentication and Session Security
SESSION_SECRET=
ADMIN_EMAILS=
ADMIN_AUDIT_TOKEN=

# Melhor Envio Logistics API
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ORIGIN_CEP=03806010
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_APP_NAME="Marmot Confeccoes"
MELHOR_ENVIO_APP_EMAIL="contato@marmot.com.br"
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_WEBHOOK_SECRET=

# Stripe Checkout (as chaves secretas são lidas somente pelo backend)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Database Configuration (PostgreSQL / Supabase / Neon / Cloud SQL)
# When configured on Vercel or locally, the server connects automatically and runs migrations
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Supabase Client Frontend (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Resend Transactional Email API
RESEND_API_KEY=
RESEND_FROM_EMAIL="Marmot Confeccoes <contato@marmotconfeccoes.com.br>"

